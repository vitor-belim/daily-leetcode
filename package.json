{
  "name": "daily-leetcode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-daily": "f(){ npm run fetch-problem -- \"$@\" && npm run fetch-solution -- \"$@\"; }; f",
    "fetch-problem": "tsx scripts/fetch-problem.ts",
    "fetch-solution": "tsx scripts/fetch-solution.ts",
    "backfill": "tsx scripts/backfill.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-progress": "^1.1.8",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "markdown-it": "^15.0.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.6",
    "shadcn": "^4.8.3",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
