{
  "name": "daily-leetcode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "fetch-daily": "f(){ npm run fetch-problem -- \"$@\" && npm run fetch-solution -- \"$@\"; }; f",
    "fetch-problem": "tsx scripts/fetch-problem.ts",
    "fetch-solution": "tsx scripts/fetch-solution.ts",
    "backfill": "tsx scripts/backfill.ts",
    "refresh-auth": "tsx scripts/refresh-auth.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "markdown-it": "^15.0.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
